.eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); font-weight: 600; }
.today { display: flex; gap: 14px; align-items: center; background: var(--accent-soft); border-radius: 14px; padding: 12px; margin-bottom: 18px; flex-wrap: wrap; }
