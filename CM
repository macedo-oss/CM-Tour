  --line: #27424c; --accent: #4cc2e0; --accent-fg: #06222b; --accent-soft: #163c48; --danger: #ef7f72;
  --c-voo: #8aa4f5; --c-cruzeiro: #4cc8e8; --c-hospedagem: #b99be3; --c-transporte: #5fcfaa; --c-passeio: #f0a45e; --c-refeicao: #e3bd63; --c-outro: #8fa6ae;
